# Copy this file to `.env` and fill only the providers/search services you use.
# Never commit `.env` or put these values in frontend code.

# -----------------------------------------------------------------------------
# LLM routing
# -----------------------------------------------------------------------------
# Recommended: copy config/providers.example.json to config/providers.json and
# point this variable to it. The JSON file supports arbitrary providers and
# models, including custom OpenAI-compatible gateways, vLLM, LM Studio, and
# local Ollama instances.
PROVIDER_CONFIG_FILE=config/providers.json

# Environment discovery fallback (used when PROVIDER_CONFIG_FILE is absent).
# Set the matching *_MODEL because model IDs are provider/account-specific.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama Cloud and local Ollama both expose an OpenAI-compatible endpoint.
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_BASE_URL=https://ollama.com/v1
LOCAL_SLM_ENABLED=false
LOCAL_SLM_MODEL=
LOCAL_SLM_BASE_URL=http://127.0.0.1:11434/v1

# Optional explicit fallback. Prefer configuring this in providers.json.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY_ENV=

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Runtime, persistence, and security boundary
# -----------------------------------------------------------------------------
ENV=dev
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_CONCURRENT_RESEARCHERS=3
REPORT_STORAGE_DIR=data/reports

# Use DATABASE_URL for a deployed PostgreSQL checkpointer. The legacy
# SUPABASE_DATABASE_URL name remains supported for existing installations.
DATABASE_URL=
SUPABASE_DATABASE_URL=

# Optional tracing.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
